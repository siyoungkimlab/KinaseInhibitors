      s_ffio_pdb_residue_name
      s_ffio_chain_name
      s_ffio_pdb_segment_name
      i_ffio_residue_number
      r_ffio_x_vel
      r_ffio_y_vel
      r_ffio_z_vel
      :::
      :::
    }
    msys_forcefield[0] {
      s_path
      s_info
      :::
      :::
    }
  }
}
